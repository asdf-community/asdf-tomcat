#!/usr/bin/env bash

cat <<EOT
Environment variables:
  ASDF_TOMCAT_MIRROR         Base URL used instead of https://dlcdn.apache.org/tomcat,
                             the Apache archive stays the fallback.
  ASDF_TOMCAT_SKIP_CHECKSUM  Any non-empty value skips checksum verification.
  ASDF_TOMCAT_CACHE_TTL      Seconds to keep the version list in
                             \${XDG_CACHE_HOME:-~/.cache}/asdf-tomcat, 3600 by default, 0 disables.
EOT
