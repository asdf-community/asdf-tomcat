#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

# Versions installed by plugin 1.x have no PATH_DIR and keep the whole bin/.
if [ -n "${ASDF_INSTALL_PATH:-}" ] && [ ! -d "$ASDF_INSTALL_PATH/$PATH_DIR" ]; then
	echo bin
else
	echo "$PATH_DIR"
fi
